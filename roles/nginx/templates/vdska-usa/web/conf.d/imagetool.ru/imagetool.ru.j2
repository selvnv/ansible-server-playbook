server {
    listen {{ nginx_instance_port }} ssl http2;
    listen [::]:{{ nginx_instance_port }} ssl http2;
    server_name {{ nginx_vhost.server_name }};

    keepalive_timeout 65;
    client_max_body_size 20m;

    {% if nginx_vhost.ssl.type == 'letsencrypt' %}
        ssl_certificate {{ nginx_ssl_live_dir }}/{{ nginx_vhost.server_name }}/fullchain.pem;
        ssl_certificate_key {{ nginx_ssl_live_dir }}/{{ nginx_vhost.server_name }}/privkey.pem;
    {% endif %}

    {% if nginx_vhost.ssl.type == 'custom' %}
        ssl_certificate {{ nginx_ssl_custom_dir }}/{{ nginx_vhost.server_name }}/fullchain.pem;
        ssl_certificate_key {{ nginx_ssl_custom_dir }}/{{ nginx_vhost.server_name }}/privkey.pem;
    {% endif %}

    ssl_dhparam {{ nginx_ssl_dir }}/dhparams.pem;

    include {{ nginx_common_dir }}/ssl_params.conf;

    root {{ nginx_static_dir }}/{{ nginx_vhost.server_name }};
    index index.html;

    # API
    location /v1/ {
        proxy_pass http://app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location /health {
        proxy_pass http://app;
        access_log off;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
